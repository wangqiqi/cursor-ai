{
  "version": 1,
  "enabled": true,
  "description": "复制为 .cursorGrowth/temp-cleanup.json。母版不写项目专有前缀（sais-* · rdm-* 等在此登记）。",
  "rules": [
    {
      "id": "ephemeral-workdirs",
      "glob": "/tmp/myapp-*",
      "tier": "ephemeral",
      "after": ["test", "verify", "task-verify"]
    },
    {
      "id": "session-fixtures",
      "glob": "/tmp/myapp-session-*",
      "tier": "persistent",
      "max_age_hours": 72,
      "after": ["sweep"]
    }
  ]
}
